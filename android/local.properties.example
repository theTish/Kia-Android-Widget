# Copy this file to local.properties and fill in the real values.
# local.properties is gitignored. Do not commit it, and do not paste the
# key into any file that is tracked by git.

# Path to your Android SDK.
sdk.dir=C\:\\Users\\leeti\\AppData\\Local\\Android\\Sdk

# Your API base URL, no trailing slash.
KIA_BASE_URL=https://kia.tishman.ca

# The value of SECRET_KEY in your Vercel environment.
KIA_SECRET=put-your-rotated-key-here

# Which climate preset the Climate button sends: winter, summer or springfall.
KIA_CLIMATE_PRESET=winter
