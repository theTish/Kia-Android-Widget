<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET and ACCESS_NETWORK_STATE come from :core, which owns the
         networking, and merge in from its manifest. -->

    <!-- The geofence. Background location is the one that matters: without it
         the ring only fires while the app is open, which is never the moment
         you walk away from the car. All three are requested at runtime, and
         the feature is off until they are granted. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only to read which paired device just disconnected. Nothing here scans,
         advertises, or opens a connection. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/KiaTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- The car's Bluetooth going and coming back. Both actions are exempt
             from the background broadcast restrictions, so they arrive with the
             app closed, which is the only way auto-lock works at all. -->
        <receiver
            android:name=".CarBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ClimateActivity"
            android:exported="false"
            android:label="@string/climate_title" />

        <activity
            android:name=".GeofenceActivity"
            android:exported="false"
            android:label="@string/geofence_title" />

        <receiver
            android:name=".KiaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kia_widget_info" />

        </receiver>

    </application>

</manifest>
