<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        NoActionBar because both screens draw their own header: the title bar
        would sit above the design's own one saying the same thing twice.
    -->
    <style name="KiaTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <!-- ── The three big controls ─────────────────────────────────────── -->

    <style name="Control">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">104dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ControlIcon">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="ControlLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ── Cards ──────────────────────────────────────────────────────── -->

    <!-- Chakra Petch and wide tracking: these read as machine labels, which is
         what keeps them from competing with the values underneath. -->
    <style name="CardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/chakra_petch_semibold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CardFigure">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/chakra_petch_semibold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="CardFigureSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Metric">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="MetricLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MetricValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">@font/chakra_petch_semibold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- ── Label/value rows ───────────────────────────────────────────── -->

    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- ── Settings ───────────────────────────────────────────────────── -->

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Segment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/segment_idle</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
