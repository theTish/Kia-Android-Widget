<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Headline: the two things worth seeing before anything else. -->
        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ready"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lock_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <!-- Controls -->
        <Button
            android:id="@+id/lock"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/lock"
            android:drawableStart="@drawable/ic_lock"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/lock"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <Button
            android:id="@+id/unlock"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/unlock"
            android:drawableStart="@drawable/ic_unlock"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/unlock"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <Button
            android:id="@+id/climate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/climate"
            android:drawableStart="@drawable/ic_climate"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/climate"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <!-- Detail. Populated from /status; sections hide when there is
             nothing to say rather than showing empty headings. -->
        <TextView
            android:id="@+id/warnings_heading"
            style="@style/SectionHeading"
            android:text="@string/section_attention" />

        <TextView
            android:id="@+id/warnings"
            style="@style/SectionBody"
            android:textColor="@color/armed_text" />

        <TextView
            android:id="@+id/charge_heading"
            style="@style/SectionHeading"
            android:text="@string/section_charge" />

        <TextView
            android:id="@+id/charge"
            style="@style/SectionBody" />

        <TextView
            android:id="@+id/climate_heading"
            style="@style/SectionHeading"
            android:text="@string/section_climate" />

        <TextView
            android:id="@+id/climate_info"
            style="@style/SectionBody" />

        <TextView
            android:id="@+id/car_heading"
            style="@style/SectionHeading"
            android:text="@string/section_car" />

        <TextView
            android:id="@+id/car"
            style="@style/SectionBody" />

        <Button
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/neutral"
            android:text="@string/show_on_map"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/neutral"
            android:text="@string/refresh"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/background"
            android:text="@string/settings"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
