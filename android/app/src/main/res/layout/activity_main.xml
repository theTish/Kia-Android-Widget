<?xml version="1.0" encoding="utf-8"?>
<!--
    Home. Reading order is deliberate: the car, then charge, then the controls,
    then everything that is only worth knowing when something is wrong.

    Sections below the controls are populated from /status and hidden when the
    car reports nothing for them, rather than showing an empty heading.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- ── Header ────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/chakra_petch_bold"
                        android:layout_marginEnd="6dp"
                        android:letterSpacing="0.08"
                        android:text="@string/model_name"
                        android:textColor="@color/text"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/chakra_petch_bold"
                        android:letterSpacing="0.08"
                        android:text="@string/model_trim"
                        android:textColor="@color/accent"
                        android:textSize="20sp" />

                </LinearLayout>

                <!-- The one status slot on this screen: freshness normally,
                     and whatever an action or a failure has to say otherwise. -->
                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    tools:text="Updated 22:12" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_button"
                android:contentDescription="@string/refresh"
                android:scaleType="center"
                android:src="@drawable/ic_refresh"
                android:tint="@color/text" />

            <ImageButton
                android:id="@+id/settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_button"
                android:contentDescription="@string/settings"
                android:scaleType="center"
                android:src="@drawable/ic_settings"
                android:tint="@color/text" />

        </LinearLayout>

        <!-- ── Hero ──────────────────────────────────────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:layout_marginTop="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/hero_glow" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/hero_hairline" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/car_image"
                android:src="@drawable/ev6_gt" />

        </FrameLayout>

        <!-- ── Charge headline ───────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/chakra_petch_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:text="@string/no_value"
                        android:textColor="@color/text"
                        android:textSize="88sp"
                        tools:text="78" />

                    <TextView
                        android:id="@+id/battery_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/chakra_petch_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/percent_sign"
                        android:textColor="@color/text_dim"
                        android:textSize="32sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_dim"
                    android:textSize="17sp"
                    tools:text="412 km range" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lock_chip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/chip"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/lock_chip_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/accent" />

                <TextView
                    android:id="@+id/lock_chip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/manrope_semibold"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    tools:text="Locked" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Charge bar ────────────────────────────────────────────── -->
        <ca.thetish.kia.app.BatteryBarView
            android:id="@+id/battery_bar"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="24dp">

            <TextView
                android:id="@+id/charge_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                tools:text="Not plugged in" />

            <TextView
                android:id="@+id/charge_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                tools:text="Limit 80%" />

        </LinearLayout>

        <!-- ── Controls ──────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="16dp"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/lock"
                style="@style/Control"
                android:background="@drawable/control_accent"
                android:contentDescription="@string/lock">

                <ImageView
                    android:id="@+id/lock_icon"
                    style="@style/ControlIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/accent_ink" />

                <TextView
                    android:id="@+id/lock_label"
                    style="@style/ControlLabel"
                    android:text="@string/lock"
                    android:textColor="@color/accent_ink" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/unlock"
                style="@style/Control"
                android:background="@drawable/control_surface"
                android:contentDescription="@string/unlock">

                <ImageView
                    android:id="@+id/unlock_icon"
                    style="@style/ControlIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_unlock"
                    android:tint="@color/text" />

                <TextView
                    android:id="@+id/unlock_label"
                    style="@style/ControlLabel"
                    android:text="@string/unlock"
                    android:textColor="@color/text" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/climate"
                style="@style/Control"
                android:background="@drawable/control_surface"
                android:contentDescription="@string/climate">

                <ImageView
                    style="@style/ControlIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_climate"
                    android:tint="@color/text" />

                <TextView
                    style="@style/ControlLabel"
                    android:text="@string/climate"
                    android:textColor="@color/text" />

            </LinearLayout>

        </LinearLayout>

        <!-- Kept at a fixed height so arming does not shunt the whole page. -->
        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_horizontal"
            android:textColor="@color/armed"
            android:textSize="13sp" />

        <!-- ── Detail ────────────────────────────────────────────────── -->

        <LinearLayout
            android:id="@+id/attention_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/card_attention"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                android:tint="@color/armed" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CardLabel"
                    android:fontFamily="@font/manrope_bold"
                    android:letterSpacing="0.1"
                    android:text="@string/section_attention"
                    android:textColor="@color/armed"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/attention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    tools:text="Tyre: front left" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bolt"
                    android:tint="@color/text_dim" />

                <TextView
                    style="@style/CardLabel"
                    android:layout_marginStart="10dp"
                    android:text="@string/section_charge" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false">

                <LinearLayout style="@style/Metric">

                    <TextView
                        style="@style/MetricLabel"
                        android:text="@string/metric_ac_limit" />

                    <TextView
                        android:id="@+id/ac_limit"
                        style="@style/MetricValue"
                        tools:text="80%" />

                </LinearLayout>

                <LinearLayout style="@style/Metric">

                    <TextView
                        style="@style/MetricLabel"
                        android:text="@string/metric_dc_limit" />

                    <TextView
                        android:id="@+id/dc_limit"
                        style="@style/MetricValue"
                        tools:text="90%" />

                </LinearLayout>

                <LinearLayout style="@style/Metric">

                    <TextView
                        style="@style/MetricLabel"
                        android:text="@string/metric_12v" />

                    <TextView
                        android:id="@+id/battery_12v"
                        style="@style/MetricValue"
                        tools:text="88%" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CardLabel"
                    android:text="@string/section_climate" />

                <TextView
                    android:id="@+id/climate_value"
                    style="@style/CardFigure"
                    android:layout_marginTop="12dp"
                    tools:text="21°" />

                <TextView
                    android:id="@+id/climate_sub"
                    style="@style/CardFigureSub"
                    tools:text="Off · winter preset" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CardLabel"
                    android:text="@string/section_service" />

                <TextView
                    android:id="@+id/service_value"
                    style="@style/CardFigure"
                    android:layout_marginTop="12dp"
                    tools:text="1,580" />

                <TextView
                    android:id="@+id/service_sub"
                    style="@style/CardFigureSub"
                    android:text="@string/service_sub" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp">

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_odometer" />

                <TextView
                    android:id="@+id/odometer"
                    style="@style/RowValue"
                    tools:text="18,420 km" />

            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_doors" />

                <TextView
                    android:id="@+id/doors"
                    style="@style/RowValue"
                    tools:text="All shut" />

            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_windows" />

                <TextView
                    android:id="@+id/windows"
                    style="@style/RowValue"
                    tools:text="Not reported" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/pill_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pin"
                android:tint="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/manrope_semibold"
                android:text="@string/show_on_map"
                android:textColor="@color/text"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
