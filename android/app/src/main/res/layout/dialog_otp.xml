<?xml version="1.0" encoding="utf-8"?>
<!-- Kia's 90-day device check. Opens when a call comes back "Kia needs a
     code": one button has Kia email the code, the field takes it, and the same
     button then hands it to the server. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/CardLabel"
        android:text="@string/otp_title" />

    <TextView
        android:id="@+id/otp_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/otp_body"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/otp_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:autofillHints="smsOTPCode"
        android:hint="@string/otp_code_hint"
        android:importantForAutofill="yes"
        android:inputType="number"
        android:maxLength="8"
        android:textColor="@color/text"
        android:textColorHint="@color/text_muted"
        android:textSize="22sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/otp_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end">

        <TextView
            android:id="@+id/otp_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="@font/manrope_semibold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/charge_limit_cancel"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/otp_action"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="@font/manrope_semibold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/otp_send"
            android:textColor="@color/accent"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
