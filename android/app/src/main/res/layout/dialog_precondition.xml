<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-conditioning schedule, opened from its row on the home screen.
     Read-only: the timers are set in Kia's own app or in the car. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/CardLabel"
        android:text="@string/precondition_title" />

    <LinearLayout
        android:id="@+id/precondition_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/precondition_none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/precondition_none"
        android:textColor="@color/text_dim"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/precondition_footnote"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/precondition_close"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:fontFamily="@font/manrope_semibold"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/precondition_close"
        android:textColor="@color/accent"
        android:textSize="15sp" />

</LinearLayout>
