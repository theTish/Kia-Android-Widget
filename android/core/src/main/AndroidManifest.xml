<?xml version="1.0" encoding="utf-8"?>
<!--
    This module is the only thing that touches the network, so it declares the
    permissions it needs. They merge into every consumer, which means neither
    the tile nor the phone app has to remember to repeat them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
